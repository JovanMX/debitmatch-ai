# LLM configuration (OpenAI)
OPENAI_API_KEY=your_openai_api_key_here
# Profiling / memory model (non-reasoning). OPENAI_TEMPERATURE applies to non-reasoning models only:
# reasoning models (gpt-5 / gpt-6 / o-series) accept only their default temperature.
OPENAI_MODEL_NAME=gpt-4o-mini
OPENAI_TEMPERATURE=0.1

# Optional per-task overrides (defaults in config.TASK_MODEL_DEFAULTS):
# DEBITMATCH_MODEL_PROFILING=gpt-4o-mini
# DEBITMATCH_MODEL_ADVISORY=gpt-6-luna
# DEBITMATCH_REASONING_EFFORT_ADVISORY=none
# DEBITMATCH_MODEL_CRITIC=gpt-6-luna
# DEBITMATCH_REASONING_EFFORT_CRITIC=none
# DEBITMATCH_MODEL_JUDGE=gpt-6.1-terra        # benchmark judge (EVAL_JUDGE_MODEL also overrides it)

# LangSmith configuration (observability)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=debitmatch-ai-eval
